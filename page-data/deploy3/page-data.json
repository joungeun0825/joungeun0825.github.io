wBox=\"0 0 24 24\"><path d=\"M6.188 8.719c.439-.439.926-.801 1.444-1.087 2.887-1.591 6.589-.745 8.445 2.069l-2.246 2.245c-.644-1.469-2.243-2.305-3.834-1.949-.599.134-1.168.433-1.633.898l-4.304 4.306c-1.307 1.307-1.307 3.433 0 4.74 1.307 1.307 3.433 1.307 4.74 0l1.327-1.327c1.207.479 2.501.67 3.779.575l-2.929 2.929c-2.511 2.511-6.582 2.511-9.093 0s-2.511-6.582 0-9.093l4.304-4.306zm6.836-6.836l-2.929 2.929c1.277-.096 2.572.096 3.779.574l1.326-1.326c1.307-1.307 3.433-1.307 4.74 0 1.307 1.307 1.307 3.433 0 4.74l-4.305 4.305c-1.311 1.311-3.44 1.3-4.74 0-.303-.303-.564-.68-.727-1.051l-2.246 2.245c.236.358.481.667.796.982.812.812 1.846 1.417 3.036 1.704 1.542.371 3.194.166 4.613-.617.518-.286 1.005-.648 1.444-1.087l4.304-4.305c2.512-2.511 2.512-6.582.001-9.093-2.511-2.51-6.581-2.51-9.092 0z\"/></svg></a>This file will automatically load configuration files provided by other</h1>\n<p>server {\nlisten 80;\nserver_name wherewearbackend.store www.wherewearbackend.store;</p>\n<div class=\"gatsby-highlight\" data-language=\"text\"><pre class=\"language-text\"><code class=\"language-text\"># HTTP에서 HTTPS로 리디렉션\nlocation / {\n    return 301 https://$host$request_uri;\n}</code></pre></div>\n<p>}</p>\n<p>server {\nlisten 443 ssl;\nserver_name wherewearbackend.store www.wherewearbackend.store;</p>\n<div class=\"gatsby-highlight\" data-language=\"text\"><pre class=\"language-text\"><code class=\"language-text\">ssl_certificate /etc/letsencrypt/live/wherewearbackend.store/fullchain.pem;\nssl_certificate_key /etc/letsencrypt/live/wherewearbackend.store/privkey.pem;\ninclude /etc/letsencrypt/options-ssl-nginx.conf;\nssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;\n\nlocation / {\n    proxy_pass http://127.0.0.1:8081;  # Docker 컨테이너의 IP와 포트\n    proxy_set_header Host $host;\n    proxy_set_header X-Real-IP $remote_addr;\n    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n    proxy_set_header X-Forwarded-Proto $scheme;\n}</code></pre></div>\n<p>}</p>\n<div class=\"gatsby-highlight\" data-language=\"text\"><pre class=\"language-text\"><code class=\"language-text\">{\n  \"settings\": {\n    \"analysis\": {\n      \"analyzer\": {\n        \"edge_ngram_analyzer\": {\n          \"type\": \"custom\",\n          \"tokenizer\": \"edge_ngram_tokenizer\"\n        }\n      },\n      \"tokenizer\": {\n        \"edge_ngram_tokenizer\": {\n          \"type\": \"edge_ngram\",\n          \"min_gram\": 1,\n          \"max_gram\": 10,\n          \"token_chars\": [\n            \"letter\",\n            \"digit\"\n          ]\n        }\n      }\n    }\n  },\n  \"mappings\": {\n    \"properties\": {\n      \"placeName\": {\n        \"type\": \"text\",\n        \"analyzer\": \"edge_ngram_analyzer\",\n        \"copy_to\": \"search_field\"\n      },\n      \"address\": {\n        \"type\": \"text\",\n        \"analyzer\": \"edge_ngram_analyzer\",\n        \"copy_to\": \"search_field\"\n      },\n      \"search_field\": {\n        \"type\": \"text\",\n        \"analyzer\": \"edge_ngram_analyzer\"\n      }\n    }\n  }\n}</code></pre></div>\n<p>ref:\n<a href=\"https://medium.com/@hongseongho/ci-cd-%ED%94%8C%EB%9E%AB%ED%8F%BC%EA%B3%BC-%EA%B8%B0%EB%B3%B8-%EA%B0%9C%EB%85%90-%EC%95%8C%EC%95%84%EB%B3%B4%EA%B8%B0-8ca07a16933c\">https://medium.com/@hongseongho/ci-cd-%ED%94%8C%EB%9E%AB%ED%8F%BC%EA%B3%BC-%EA%B8%B0%EB%B3%B8-%EA%B0%9C%EB%85%90-%EC%95%8C%EC%95%84%EB%B3%B4%EA%B8%B0-8ca07a16933c</a></p>","frontmatter":{"title":"Google Cloud Platform에서 Jenkins docker container 실행하기","date":"October 01, 2024","update":"October 01, 2021","tags":["CI/CD","Jenkins","프로젝트","docker"],"series":null},"fields":{"slug":"/deploy3/","readingTime":{"minutes":12.965}}},"seriesList":{"edges":[{"node":{"id":"d3e3f358-6ff9-5e74-a11a-ad8b990721f1","fields":{"slug":"/deploy3/"},"frontmatter":{"title":"Google Cloud Platform에서 Jenkins docker container 실행하기"}}},{"node":{"id":"926b5e59-e6c2-5645-8db2-7def69c806e4","fields":{"slug":"/jpa1/"},"frontmatter":{"title":"JPA에서 객체 변경 시 save() 호출이 필요할까? - 영속성